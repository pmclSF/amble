# ─── Personal walking data — NEVER publish ───
# Recorded GPS tracks (reveal where/when you walk + heart rate), progress
# records, downloaded map caches, and generated walk files. All of this is
# local — fetch/generate it yourself with the CLI.
data/*
cache/
walks/
maps/*
*.gpx
*.geojson
*.route.json
*.jpg
*.jpeg
*.png

# Keep empty data + maps dirs in the repo
!data/.gitkeep
!maps/.gitkeep

# ─── Python ───
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# ─── Editor / OS cruft ───
.DS_Store
.claude/

# ─── Local assistant context (personal; references home location) ───
CLAUDE.md
